# Discord application for this Mabusaba bot (create a NEW application, do not reuse p1228's or logbot's).
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Where the SQLite data is stored. Default: ./data/mabusaba.db
DATA_DIR=./data
# Optional: Watching status text shown as "○○を視聴中". Default: まぶさばを見守り中
# Can also be changed live with /watching set (stored in SQLite, takes precedence).
WATCHING_TEXT=まぶさばを見守り中
